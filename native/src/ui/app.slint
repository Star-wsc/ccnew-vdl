import { Button, LineEdit, ScrollView } from "std-widgets.slint";

struct TaskData {
    id: string, title: string, author: string, platform: string,
    status: string, progress: float, speed: string,
}

component TaskCard inherits Rectangle {
    in property <TaskData> task;
    height: 100px;
    background: #0e1420;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255,255,255,0.07);
    HorizontalLayout {
        padding: 12px; spacing: 12px;
        VerticalLayout {
            alignment: center; spacing: 4px;
            Text { text: task.title; font-size: 13px; font-weight: 600; color: #e6edf6; overflow: elide; }
            HorizontalLayout { spacing: 8px;
                Text { text: task.platform == "douyin" ? "抖音" : task.platform == "bilibili" ? "B站" : ""; font-size: 11px; color: #3dd6ff; }
                Text { text: task.author; font-size: 11px; color: #8a94aa; }
                Text { text: task.status; font-size: 11px; color: task.status == "completed" ? #00ffa3 : task.status == "failed" ? #ff5470 : #8a94aa; }
            }
            Rectangle { height: 4px; border-radius: 2px; background: #111c2b;
                Rectangle { width: parent.width * task.progress / 100; border-radius: 2px; background: #00ffa3; x: 0; }
            }
            HorizontalLayout {
                Text { text: round(task.progress) + "%"; font-size: 10px; color: #8a94aa; }
                Text { text: task.speed; font-size: 10px; color: #8a94aa; horizontal-alignment: right; }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "CCNEW 视频下载器"; preferred-width: 1100px; preferred-height: 720px; background: #05070d;
    in-out property <string> url-input: "";
    in-out property <string> status-text: "就绪";
    in-out property <int> downloading-count: 0;
    in-out property <int> completed-count: 0;
    in-out property <int> failed-count: 0;
    in-out property <[TaskData]> tasks;
    callback parse-clicked(string);
    callback url-submitted(string);
    VerticalLayout {
        HorizontalLayout { height: 52px; padding-left: 20px; spacing: 16px;
            Text { text: "CCNEW"; font-size: 18px; font-weight: 700; color: #00ffa3; vertical-alignment: center; }
            Text { text: "视频下载器"; font-size: 13px; color: #8a94aa; vertical-alignment: center; }
            Rectangle { }
            Text { text: "下载中:" + downloading-count; font-size: 12px; color: #3dd6ff; vertical-alignment: center; }
            Text { text: "完成:" + completed-count; font-size: 12px; color: #00ffa3; vertical-alignment: center; }
            Text { text: "失败:" + failed-count; font-size: 12px; color: #ff5470; vertical-alignment: center; }
        }
        Rectangle { height: 70px; background: rgba(14,20,32,0.62); border-radius: 12px; border-width: 1px; border-color: rgba(255,255,255,0.08);
            HorizontalLayout { padding: 16px; spacing: 10px;
                LineEdit { text: url-input; placeholder-text: "粘贴 B站 / 抖音 视频链接…"; accepted => { url-submitted(self.text); } edited(t) => { url-input = t; } horizontal-stretch: 1; }
                Button { text: "解析"; primary: true; clicked => { parse-clicked(url-input); } }
            }
        }
        ScrollView { vertical-stretch: 1;
            VerticalLayout { padding: 16px; spacing: 8px;
                if tasks.length == 0: Text { text: "暂无下载任务"; color: #59637a; horizontal-alignment: center; }
                for t[i] in tasks: TaskCard { task: t; }
            }
        }
        HorizontalLayout { height: 28px; padding-left: 16px;
            Text { text: status-text; font-size: 11px; color: #59637a; vertical-alignment: center; }
        }
    }
}
